# Private key of the deployer wallet (0x-prefixed, no funds needed for local testing)
DEPLOYER_PRIVATE_KEY=0x...

# Base Sepolia RPC — free tier from Alchemy or the public endpoint works fine
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Shop wallet address — receives NFTs when a loan is swept (defaulted)
SHOP_ADDRESS=0x...

# Basescan API key — only needed for contract verification (optional)
BASESCAN_API_KEY=
