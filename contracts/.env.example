# Private key of the deployer wallet (0x-prefixed, no funds needed for local testing)
DEPLOYER_PRIVATE_KEY=0x...

# Ethereum Mainnet — the existing escrow proxy is deployed here (chain ID 1)
ETHEREUM_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Shop wallet address — receives NFTs when a loan is swept (defaulted)
SHOP_ADDRESS=0x...

# Etherscan API key — only needed for command-line verification (optional)
ETHERSCAN_API_KEY=

# V3 upgrade proposal settings (never put owner/signer private keys here)
EXPECTED_PROXY_OWNER=0x...
OFFER_SIGNER=0x...
CANDIDATE_IMPLEMENTATION=0x...
FIRST_NEW_LOAN_ID=
ACTIVE_LOANS_JSON=/absolute/path/to/reviewed-active-loans.json
