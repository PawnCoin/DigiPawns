rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Public profile data is readable to signed-in users. Users can only edit
    // display and wallet-link fields; privilege and balance fields are protected.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('balance', 0) == 0;
      allow update: if isAdmin() || (
        isOwner(userId)
        && onlyChanges(['username', 'avatarNftUrl', 'walletAddress', 'solanaAddress'])
      );
      allow delete: if isAdmin();
    }

    match /notificationSettings/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Borrowers may submit a loan request, but only an administrator/trusted
    // backend may change financial terms or lifecycle state after creation.
    match /loans/{loanId} {
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /friends/{friendshipId} {
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || resource.data.friendUid == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.friendUid != request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.friendUid == resource.data.friendUid;
      allow delete: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || resource.data.friendUid == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && onlyChanges(['read', 'readAt']);
      allow delete: if false;
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Marketplace inventory and ownership records are financial state.
    // They must only be mutated by an administrator or trusted backend.
    match /shopInventory/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ownedItems/{itemId} {
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/watchedWallets/{walletId} {
      allow read, create, update, delete: if isOwner(userId);
    }
  }
}
